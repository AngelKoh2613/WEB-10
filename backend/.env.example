# Copy to .env for local use. Never commit .env or replace these placeholders with real secrets.

NODE_ENV=development
PORT=3000

# Local development database. Port 5432 is the machine PostgreSQL service.
# Port 5433 is used by another local container. SecurePlan uses 5434.
# Copy this file to .env and replace the password. Never commit .env.
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql://secureplan:replace-me@127.0.0.1:5434/secureplan_dev

# Required to sign access tokens. Use at least 32 characters. Do not commit a real value.
# Generate one locally, for example: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-with-a-local-secret-of-at-least-32-chars
